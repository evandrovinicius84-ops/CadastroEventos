<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://microsoft.com"
             xmlns:x="http://microsoft.com"
             x:Class="CadastroEventos.Views.ResumoPage"
             Title="Resumo do Evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Resumo do Evento" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,10" TextColor="#512BD4"/>

            <Frame BorderColor="#E0E0E0" CornerRadius="8" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Nome}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,5"/>
                    <BoxView HeightRequest="1" Color="#E0E0E0" HorizontalOptions="Fill"/>

                    <Label Text="{Binding Local, StringFormat='📍 Local: {0}'}" FontSize="16"/>

                    <Label Text="{Binding DataInicio, StringFormat='📅 Início: {0:dd/MM/yyyy}'}" FontSize="16"/>
                    <Label Text="{Binding DataTermino, StringFormat='📅 Término: {0:dd/MM/yyyy}'}" FontSize="16"/>

                    <!-- Exibe os dias calculados pelo TimeSpan na model -->
                    <Label Text="{Binding DuracaoEmDias, StringFormat='⏳ Duração: {0} dia(s)'}" FontSize="16" FontAttributes="Bold"/>

                    <Label Text="{Binding NumeroParticipantes, StringFormat='👥 Participantes: {0}'}" FontSize="16"/>
                    <Label Text="{Binding CustoPorParticipante, StringFormat='💰 Custo por pessoa: R$ {0:F2}'}" FontSize="16"/>

                    <BoxView HeightRequest="1" Color="#E0E0E0" HorizontalOptions="Fill" Margin="0,5"/>

                    <!-- Exibe o custo total calculado automaticamente -->
                    <Label Text="{Binding CustoTotal, StringFormat='💵 Custo Total: R$ {0:F2}'}" FontSize="18" FontAttributes="Bold" HorizontalOptions="End" TextColor="Green"/>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Voltar" 
                    Clicked="OnVoltarClicked" 
                    BackgroundColor="Gray" 
                    TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
